{
  "name": "weight-recorder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "轻迹 · A private, local-first weight journal",
  "engines": { "node": ">=24.0.0" },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx watch server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/launch.mjs",
    "serve": "tsx server/index.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  }
}
